<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Viagem.Views.ViagemPage"
             xmlns:viewmodels="clr-namespace:Viagem.ViewModels"
             xmlns:models="clr-namespace:Viagem.Models"
             x:DataType="viewmodels:ViagemViewModel"
             BackgroundColor="#FFFFFF"
             Shell.NavBarIsVisible="False"
             Title="ViagemPage">

    <Grid RowDefinitions="*, Auto, Auto" Padding="5,10">
        <CarouselView IndicatorView="Indicador"
              Grid.Row="0"
              Position="{Binding Posicao}"
              Loop="False"
              ItemsSource="{Binding Itens}">

            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="models:ViagemItem">
                    <VerticalStackLayout VerticalOptions="Center"
                        Spacing="10">

                        <Image Source="{Binding ImageUrl}"
                        Aspect="AspectFit"
                        HeightRequest="300"
                        />

                        <Label 
                        FontSize="32"
                        HorizontalTextAlignment="Center"
                        Text="{Binding Titulo}"
                        TextColor="#333"
                        FontAttributes="Bold"/>

                        <Label FontSize="32"
                        HorizontalOptions="Center"
                        Text="{Binding Subtitulo}" 
                        TextColor="#333"
                        FontAttributes="Bold"
                        />

                        <Label Text="{Binding Descricao}"
                        FontSize="16"
                        TextColor="#333"
                        HorizontalTextAlignment="Center"
                        />
                    </VerticalStackLayout>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <IndicatorView x:Name="Indicador"
               Grid.Row="1"
               HorizontalOptions="Center"
               IndicatorColor="#FFE3ED"
               IndicatorSize="10"
               SelectedIndicatorColor="#FF1568"/>

        <Grid Grid.Row="2"
            ColumnDefinitions="*,*" 
            ColumnSpacing="15"
            Padding="0, 15, 0, 0">

            <Button Grid.Column="0"
            Text= "Get Started"
            BackgroundColor="#FF1568"
            FontSize="20"/>

            <Button Grid.Column="1"
            Command="{Binding ProximoCommand}"
            Text="Next"
            BackgroundColor="#4EA717"
            WidthRequest="101"
            FontSize="20"
            IsVisible="{Binding ExibirBotao}"/>
        </Grid>
        
    </Grid>
</ContentPage>